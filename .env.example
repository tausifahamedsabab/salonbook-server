# Copy to .env for local development and fill in real values locally.
# NEVER commit filled-in values — this file contains variable NAMES only.

# Server
PORT=
MONGODB_URI=
# LOCAL ONLY (leave unset on Vercel): comma-separated DNS servers for sandboxes
# that cannot resolve MongoDB SRV records, e.g. 8.8.8.8,8.8.4.4
DNS_SERVERS=
JWT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=
AUTH_COOKIE_CROSS_SITE=

# Seeded admin account (created once on first start)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_ADMIN_REGISTRATION=

# Stripe (test mode keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB image hosting
IMGBB_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
